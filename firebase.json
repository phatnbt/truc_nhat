{
  "firestore": {
    "rules": "firestore-secure.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore-secure.rules",
      "README*.md",
      "VALIDATION.json",
      ".firebaserc*",
      ".git/**",
      ".github/**",
      "functions/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {"source": "**", "destination": "/index.html"}
    ]
  }
}
