rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function configPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId)/security/config; }
    function roomPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId); }
    function accessPath(roomId, uid) { return /databases/$(database)/documents/rooms/$(roomId)/access/$(uid); }
    function memberDataPath(roomId, uid) { return /databases/$(database)/documents/rooms/$(roomId)/memberData/$(uid); }
    function taskSubmissionPath(roomId, submissionId) { return /databases/$(database)/documents/rooms/$(roomId)/taskSubmissions/$(submissionId); }

    function isPrimaryAdmin(roomId) {
      return hasActiveAccess(roomId)
        && exists(configPath(roomId))
        && get(configPath(roomId)).data.adminUid == request.auth.uid;
    }
    function isPrimaryUid(roomId, uid) {
      return exists(configPath(roomId))
        && get(configPath(roomId)).data.adminUid == uid;
    }
    function hasActiveAccess(roomId) {
      return signedIn()
        && exists(accessPath(roomId, request.auth.uid))
        && get(accessPath(roomId, request.auth.uid)).data.active == true;
    }
    function isAdmin(roomId) {
      return isPrimaryAdmin(roomId)
        || (hasActiveAccess(roomId) && get(accessPath(roomId, request.auth.uid)).data.role == 'admin');
    }
    function ownMemberId(roomId) {
      return get(accessPath(roomId, request.auth.uid)).data.memberId;
    }
    function accessDisplayName(roomId) {
      return get(accessPath(roomId, request.auth.uid)).data.get('displayName', '');
    }
    function validActorName(roomId) {
      let accessName = accessDisplayName(roomId);
      let tokenName = request.auth.token.get('name', '');
      let tokenEmail = request.auth.token.get('email', '');
      return request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 120
        && (
          (accessName is string && accessName.size() > 0 && request.resource.data.actorName == accessName)
          || (tokenName is string && tokenName.size() > 0 && request.resource.data.actorName == tokenName)
          || (tokenEmail is string && tokenEmail.size() > 0 && request.resource.data.actorName == tokenEmail)
        );
    }
    function validRoomWrite(roomId) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'roomCode', 'revision', 'payload',
          'lastAdminUid', 'lastDeviceId', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 5
        && request.resource.data.roomCode == roomId
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.payload is map
        && request.resource.data.lastAdminUid == request.auth.uid
        && request.resource.data.lastDeviceId is string
        && request.resource.data.lastDeviceId.size() <= 160
        && request.resource.data.updatedAt == request.time;
    }
    function validAccessRequest() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048
        && request.resource.data.requestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'status',
          'requestedAt', 'updatedAt'
        ]);
    }
    function validMemberData(roomId) {
      return request.resource.data.memberId == ownMemberId(roomId)
        && request.resource.data.memberId is string
        && request.resource.data.presence is bool
        && request.resource.data.billingMonths is map
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'memberId', 'presence', 'billingMonths', 'updatedBy', 'updatedAt','billingPatchMonth','billingPatchPerson'
        ]);
    }
    function editableMemberBill(roomId, months) {
      let month = request.resource.data.get('billingPatchMonth', '');
      let bills = get(roomPath(roomId)).data.payload.billingMonths;
      return months.size() == 0
        || (month is string && month.matches('^\\d{4}-\\d{2}$') && months.hasOnly([month])
          && month in bills && bills[month].closed == false);
    }
    function assignmentMatches(value, taskId, memberId) {
      return value is map
        && value.taskId == taskId
        && value.personId == memberId
        && value.get('cut', false) != true
        && value.get('completed', false) != true;
    }
    function publishOwnBillingDays(roomId) {
      let own = getAfter(memberDataPath(roomId, request.auth.uid)).data;
      let month = own.get('billingPatchMonth', '');
      let key = own.get('billingPatchPerson', '');
      let before = resource.data.payload.billingMonths[month];
      let after = request.resource.data.payload.billingMonths[month];
      let beforePerson = before.people[key];
      let afterPerson = after.people[key];
      return own.memberId == ownMemberId(roomId) && own.memberId is string
        && own.updatedBy == request.auth.uid && own.updatedAt == request.time
        && before.closed == false && beforePerson.memberId == own.memberId
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payload','revision','updatedAt'])
        && request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['billingMonths'])
        && request.resource.data.payload.billingMonths.diff(resource.data.payload.billingMonths).affectedKeys().hasOnly([month])
        && after.diff(before).affectedKeys().hasOnly(['people'])
        && after.people.diff(before.people).affectedKeys().hasOnly([key])
        && afterPerson.diff(beforePerson).affectedKeys().hasOnly(['days','daysShared'])
        && afterPerson.daysShared == true && afterPerson.days is map
        && afterPerson.days == own.billingMonths[month].days;
    }
    function assignmentAtMatches(assignments, index, taskId, memberId) {
      return assignments.size() > index
        && assignmentMatches(assignments[index], taskId, memberId);
    }
    function taskIsCurrentlyAssigned(roomId, weekStart, scheduleId, taskId, memberId) {
      return scheduleHasAssignment(get(roomPath(roomId)).data.payload.schedules, weekStart, scheduleId, taskId, memberId);
    }
    function scheduleHasAssignment(schedules, weekStart, scheduleId, taskId, memberId) {
      return weekStart in schedules
        && schedules[weekStart].id == scheduleId
        && schedules[weekStart].assignments is list
        && (
          assignmentAtMatches(schedules[weekStart].assignments, 0, taskId, memberId)
          || assignmentAtMatches(schedules[weekStart].assignments, 1, taskId, memberId)
          || assignmentAtMatches(schedules[weekStart].assignments, 2, taskId, memberId)
          || assignmentAtMatches(schedules[weekStart].assignments, 3, taskId, memberId)
          || assignmentAtMatches(schedules[weekStart].assignments, 4, taskId, memberId)
          || assignmentAtMatches(schedules[weekStart].assignments, 5, taskId, memberId)
        );
    }
    function validTaskIdentity(roomId) {
      return request.resource.data.roomCode == roomId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.memberId == ownMemberId(roomId)
        && request.resource.data.scheduleId is string
        && request.resource.data.scheduleId.size() > 0
        && request.resource.data.scheduleId.size() <= 160
        && request.resource.data.weekStart is string
        && request.resource.data.weekStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.taskId in ['lavabo', 'san', 'quet', 'lau', 'tham', 'rac']
        && validActorName(roomId)
        && request.resource.data.taskName is string
        && request.resource.data.taskName.size() > 0
        && request.resource.data.taskName.size() <= 120
        && taskIsCurrentlyAssigned(
          roomId,
          request.resource.data.weekStart,
          request.resource.data.scheduleId,
          request.resource.data.taskId,
          request.resource.data.memberId
        );
    }
    function validChecklist(roomId, weekStart) {
      let checks = request.resource.data.get('checks', []);
      let schedule = get(roomPath(roomId)).data.payload.schedules[weekStart];
      return checks == ['task', 'finish']
        || (checks == [] && schedule.get('checklistVersion', 0) == 0);
    }
    function validAuditCreate(roomId) {
      return hasActiveAccess(roomId)
        && request.resource.data.roomCode == roomId
        && request.resource.data.actorUid == request.auth.uid
        && validActorName(roomId)
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.role == get(accessPath(roomId, request.auth.uid)).data.role
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 80
        && request.resource.data.summary is string
        && request.resource.data.summary.size() > 0
        && request.resource.data.summary.size() <= 600
        && (request.resource.data.targetMemberId == null || request.resource.data.targetMemberId is string)
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() <= 160
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'roomCode', 'actorUid', 'actorName', 'actorEmail', 'role',
          'action', 'summary', 'targetMemberId', 'deviceId', 'createdAt'
        ]);
    }

    match /rooms/{roomId} {
      allow read: if hasActiveAccess(roomId) || isPrimaryAdmin(roomId);
      allow create, update: if isAdmin(roomId) && validRoomWrite(roomId);
      allow update: if hasActiveAccess(roomId) && publishOwnBillingDays(roomId);
      allow delete: if false;

      match /security/{configId} {
        allow get: if configId == 'config' && isAdmin(roomId);
        allow write: if false;
      }

      match /access/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isAdmin(roomId));
        allow create: if isAdmin(roomId) && !isPrimaryUid(roomId, uid);
        allow update: if isAdmin(roomId) && (!isPrimaryUid(roomId, uid)
          || (uid == request.auth.uid && request.resource.data.role == 'admin'
            && request.resource.data.active == true && request.resource.data.email == request.auth.token.email));
        allow delete: if isAdmin(roomId) && !isPrimaryUid(roomId, uid);
      }

      match /accessRequests/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isAdmin(roomId));
        allow create, update: if signedIn() && uid == request.auth.uid && exists(configPath(roomId)) && validAccessRequest();
        allow delete: if signedIn() && (uid == request.auth.uid || isAdmin(roomId));
      }

      match /memberData/{uid} {
        allow read: if isAdmin(roomId) || (signedIn() && uid == request.auth.uid && hasActiveAccess(roomId));
        allow create: if isAdmin(roomId) || (signedIn() && uid == request.auth.uid && hasActiveAccess(roomId) && validMemberData(roomId)
          && editableMemberBill(roomId, request.resource.data.billingMonths.keys().toSet()));
        allow update: if isAdmin(roomId) || (signedIn() && uid == request.auth.uid && hasActiveAccess(roomId)
          && validMemberData(roomId)
          && editableMemberBill(roomId,request.resource.data.billingMonths.diff(resource.data.billingMonths).affectedKeys())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId', 'presence', 'billingMonths', 'updatedBy', 'updatedAt','billingPatchMonth','billingPatchPerson']));
        allow delete: if isAdmin(roomId);
      }

      match /taskSubmissions/{submissionId} {
        // submitTask() first reads its deterministic document inside a transaction.
        // A missing document contains no resource.data, so explicitly allow that
        // existence check for active members while keeping existing submissions private.
        allow read: if isAdmin(roomId)
          || (signedIn() && hasActiveAccess(roomId)
            && (!exists(taskSubmissionPath(roomId, submissionId)) || resource.data.actorUid == request.auth.uid));
        allow create: if signedIn() && hasActiveAccess(roomId) && validTaskIdentity(roomId)
          && submissionId == request.resource.data.weekStart + '__' + request.resource.data.taskId + '__' + request.resource.data.memberId
          && request.resource.data.status in ['in_progress', 'submitted']
          && (request.resource.data.status == 'in_progress'
            ? !('checks' in request.resource.data)
            : validChecklist(roomId,request.resource.data.weekStart))
          && request.resource.data.submittedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'roomCode', 'actorUid', 'actorName', 'memberId', 'scheduleId',
            'weekStart', 'taskId', 'taskName', 'status', 'submittedAt', 'updatedAt', 'checks'
          ]);
        allow update: if (isAdmin(roomId)
          && ((resource.data.status == 'submitted'
              && request.resource.data.status in ['approved', 'rejected']
              && taskIsCurrentlyAssigned(roomId, resource.data.weekStart, resource.data.scheduleId, resource.data.taskId, resource.data.memberId))
            || (resource.data.status == 'approved' && request.resource.data.status == 'rejected'
              && getAfter(roomPath(roomId)).data.revision == get(roomPath(roomId)).data.revision + 1
              && scheduleHasAssignment(getAfter(roomPath(roomId)).data.payload.schedules,
                resource.data.weekStart, resource.data.scheduleId, resource.data.taskId, resource.data.memberId)))
          && request.resource.data.reviewNote is string
          && request.resource.data.reviewNote.size() <= 300
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'updatedAt']))
          || (signedIn() && hasActiveAccess(roomId)
            && resource.data.actorUid == request.auth.uid
            && resource.data.memberId == ownMemberId(roomId)
            && resource.data.status in ['rejected', 'in_progress']
            && request.resource.data.actorUid == resource.data.actorUid
            && request.resource.data.memberId == resource.data.memberId
            && request.resource.data.status == 'submitted'
            && validChecklist(roomId,resource.data.weekStart)
            && request.resource.data.submittedAt == request.time
            && request.resource.data.updatedAt == request.time
            && taskIsCurrentlyAssigned(roomId, resource.data.weekStart, resource.data.scheduleId, resource.data.taskId, resource.data.memberId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'updatedAt','checks']));
        allow delete: if isAdmin(roomId);
      }

      match /swapRequests/{swapId} {
        allow get: if isAdmin(roomId) ||
          (hasActiveAccess(roomId) && (!exists(/databases/$(database)/documents/rooms/$(roomId)/swapRequests/$(swapId)) || resource.data.actorUid == request.auth.uid));
        allow list: if isAdmin(roomId) ||
          (hasActiveAccess(roomId) && resource.data.actorUid == request.auth.uid);
        allow create: if hasActiveAccess(roomId)
          && request.resource.data.keys().hasOnly(['actorUid','memberId','otherMemberId','weekStart','scheduleId','taskId','otherTaskId','status','createdAt','updatedAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.memberId == ownMemberId(roomId)
          && request.resource.data.otherMemberId != request.resource.data.memberId
          && request.resource.data.otherTaskId != request.resource.data.taskId
          && swapId == request.resource.data.scheduleId + '__' + request.resource.data.taskId + '__' + request.resource.data.memberId + '__' + request.resource.data.otherTaskId + '__' + request.resource.data.otherMemberId
          && request.resource.data.weekStart.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && taskIsCurrentlyAssigned(roomId,request.resource.data.weekStart,request.resource.data.scheduleId,request.resource.data.taskId,request.resource.data.memberId)
          && taskIsCurrentlyAssigned(roomId,request.resource.data.weekStart,request.resource.data.scheduleId,request.resource.data.otherTaskId,request.resource.data.otherMemberId);
        allow update: if isAdmin(roomId) && resource.data.status == 'pending'
          && request.resource.data.status in ['approved','rejected']
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','updatedAt']);
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isAdmin(roomId);
        allow create: if signedIn() && validAuditCreate(roomId);
        allow update: if isAdmin(roomId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actorEmail', 'actorName', 'summary']);
        allow delete: if isAdmin(roomId) && resource.data.createdAt < request.time - duration.value(30, 'd');
      }
    }
  }
}
